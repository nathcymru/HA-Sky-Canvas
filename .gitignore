# ==========================================
# HA-Sky-Canvas: Production .gitignore
# ==========================================

# 1. Dependency & Package Managers
node_modules/
.npm/
.yarn/
package-lock.json
yarn.lock

# 2. Build & Compilation Outputs
# (Rollup compiles ts source files into a single bundle here)
dist/
build/
*.tsbuildinfo

# 3. Code Quality, Linters & Formatter Caches
.eslintcache
.prettiercache
.stylelintcache

# 4. Logs and Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. Local Home Assistant Development & Testing
# (If you spin up a local container/instance to test the Canvas API)
config/
.HA_VERSION
*.db
*.db-shm
*.db-wal
secrets.yaml

# 6. IDE / Local Editor System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
.env
.env.local
